{
  "openapi": "3.0.3",
  "info": {
    "title": "Crosstalk",
    "version": "3.0.0",
    "description": "REST API for the Crosstalk coordination bus: presence, channels, messages, shared data, and the work board. All /api routes require the bus bearer token (Authorization: Bearer <key> or ?api_key=<key>)."
  },
  "servers": [{ "url": "/api" }],
  "security": [{ "bearerAuth": [] }, { "apiKeyQuery": [] }],
  "tags": [
    { "name": "presence" },
    { "name": "channels" },
    { "name": "messages" },
    { "name": "data" },
    { "name": "work" }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["presence"],
        "summary": "Register or refresh a session's presence",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["instance_id"],
                "properties": {
                  "instance_id": { "type": "string" },
                  "description": { "type": "string" },
                  "rev": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "instance_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/instances": {
      "get": {
        "tags": ["presence"],
        "summary": "List known sessions (stale ones are marked offline first)",
        "responses": {
          "200": {
            "description": "Instances",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instances": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Instance" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/channels": {
      "get": {
        "tags": ["channels"],
        "summary": "List channels with activity",
        "responses": {
          "200": {
            "description": "Channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channels": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Channel" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["channels"],
        "summary": "Create a channel (name is normalized)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "channel": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/channels/search": {
      "get": {
        "tags": ["channels"],
        "summary": "Search channels by name/description",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channels": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Channel" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/messages": {
      "post": {
        "tags": ["messages"],
        "summary": "Post a message (channel auto-created if new)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sender", "content"],
                "properties": {
                  "channel": { "type": "string", "default": "general" },
                  "sender": { "type": "string" },
                  "content": { "type": "string" },
                  "message_type": {
                    "type": "string",
                    "enum": ["message", "request", "response", "status", "handoff", "done"],
                    "default": "message"
                  },
                  "in_reply_to": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Posted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "id": { "type": "integer" },
                    "channel": { "type": "string" },
                    "message_type": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/messages/{channel}": {
      "get": {
        "tags": ["messages"],
        "summary": "Read a channel (latest, since after_id, or unread for an instance)",
        "parameters": [
          { "name": "channel", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "after_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "instance_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    },
                    "last_id": { "type": "integer", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/messages/{channel}/{id}/replies": {
      "get": {
        "tags": ["messages"],
        "summary": "Get a message and its replies",
        "parameters": [
          { "name": "channel", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Parent and replies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "parent": { "$ref": "#/components/schemas/Message" },
                    "replies": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["messages"],
        "summary": "Full-text-ish search across message content",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/data": {
      "get": {
        "tags": ["data"],
        "summary": "List shared-data keys",
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SharedDataSummary" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["data"],
        "summary": "Store (upsert) a shared-data value",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["key", "content", "sender"],
                "properties": {
                  "key": { "type": "string" },
                  "content": { "type": "string" },
                  "sender": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "key": { "type": "string" },
                    "size_bytes": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/data/{key}": {
      "get": {
        "tags": ["data"],
        "summary": "Fetch one shared-data value",
        "parameters": [
          { "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Value",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SharedData" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/work": {
      "get": {
        "tags": ["work"],
        "summary": "List work items (epics grouped before their children)",
        "parameters": [
          { "name": "project", "in": "query", "schema": { "type": "string" } },
          { "name": "state", "in": "query", "schema": { "type": "string" } },
          { "name": "owner", "in": "query", "schema": { "type": "string" } },
          { "name": "parent_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "kind", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/WorkItem" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["work"],
        "summary": "Create a work item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "project": { "type": "string", "default": "default" },
                  "external_ref": { "type": "string" },
                  "parent_id": { "type": "integer" },
                  "kind": { "type": "string", "enum": ["epic", "task", "bug"], "default": "task" },
                  "domain": { "type": "string" },
                  "owner": { "type": "string" },
                  "state": {
                    "type": "string",
                    "enum": ["queued", "claimed", "implementing", "in-review", "merged", "deployed", "blocked", "abandoned"],
                    "default": "queued"
                  },
                  "created_by": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/work/{id}": {
      "get": {
        "tags": ["work"],
        "summary": "Fetch one work item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "item": { "$ref": "#/components/schemas/WorkItem" } }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/work/{id}/claim": {
      "post": {
        "tags": ["work"],
        "summary": "Atomically claim a work item (mutex)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["owner"],
                "properties": { "owner": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claimed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Already claimed by another owner",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "already claimed" },
                    "owner": { "type": "string" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/work/{id}/handoff": {
      "post": {
        "tags": ["work"],
        "summary": "Transfer or release ownership (empty owner = release)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "owner": { "type": "string", "nullable": true } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transferred",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/work/{id}/state": {
      "post": {
        "tags": ["work"],
        "summary": "Set a work item's state",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["state"],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": ["queued", "claimed", "implementing", "in-review", "merged", "deployed", "blocked", "abandoned"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiKeyQuery": { "type": "apiKey", "in": "query", "name": "api_key" }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotFound": {
        "description": "Referenced id or key not found",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "Instance": {
        "type": "object",
        "properties": {
          "instance_id": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "last_seen": { "type": "string" },
          "status": { "type": "string" },
          "rev": { "type": "string", "nullable": true }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "created_at": { "type": "string" },
          "message_count": { "type": "integer" },
          "last_message_at": { "type": "string", "nullable": true },
          "active_senders": { "type": "string", "nullable": true }
        }
      },
      "Message": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "channel": { "type": "string" },
          "sender": { "type": "string" },
          "content": { "type": "string" },
          "message_type": { "type": "string" },
          "in_reply_to": { "type": "integer", "nullable": true },
          "created_at": { "type": "string" },
          "reply_count": { "type": "integer" }
        }
      },
      "SharedDataSummary": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "created_by": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "size_bytes": { "type": "integer" },
          "created_at": { "type": "string" }
        }
      },
      "SharedData": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "content": { "type": "string" },
          "created_by": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "created_at": { "type": "string" }
        }
      },
      "WorkItem": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "project": { "type": "string" },
          "title": { "type": "string" },
          "external_ref": { "type": "string", "nullable": true },
          "parent_id": { "type": "integer", "nullable": true },
          "kind": { "type": "string" },
          "domain": { "type": "string", "nullable": true },
          "owner": { "type": "string", "nullable": true },
          "state": { "type": "string" },
          "created_by": { "type": "string", "nullable": true },
          "claimed_at": { "type": "string", "nullable": true },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" }
        }
      }
    }
  }
}
